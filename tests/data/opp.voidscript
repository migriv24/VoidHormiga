rune new revision opp-3-5-1-4-rev-2025-10-06
set opp-3-5-1-4-rev-2025-10-06 summary '3.5.1.4 as published 2025-10-06'
set opp-3-5-1-4-rev-2025-10-06 text 'items which are required by law to be presented to the Council.'
set opp-3-5-1-4-rev-2025-10-06 adopted '2025-10-06'
set opp-3-5-1-4-rev-2025-10-06 from '2025-10-06'
