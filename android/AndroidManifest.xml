<?xml version="1.0" encoding="utf-8"?>
<!-- Void Hormiga on Android: the phone front-end (okf/concepts/sections/mobile.md).
     A NativeActivity plus ONE Java class, Void Maiz's org.voidmaiz.MaizActivity,
     which is what lets Android's own keyboard type into the app. The app itself is
     libvoidhormiga.so; the Java holds no logic. Interaction Combinators' manifest
     is the template, proven on phones.
     adjustNothing: the keyboard must not pan or resize the native surface (the
     phone front-end ends its screen where the keyboard begins, itself). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.voidhormiga.app">

  <uses-feature android:glEsVersion="0x00030000" android:required="true" />

  <!-- Joining an organization's database on the LAN (Void Maiz's lan.hpp:
       maiz::lan::android_manifest_permissions). All four are "normal"
       permissions: granted at install, no runtime prompt. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

  <application
      android:label="Void Hormiga"
      android:hasCode="true"
      android:extractNativeLibs="true"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <activity
        android:name="org.voidmaiz.MaizActivity"
        android:windowSoftInputMode="adjustNothing"
        android:exported="true"
        android:screenOrientation="portrait"
        android:launchMode="singleTask"
        android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode">
      <meta-data android:name="android.app.lib_name"
                 android:value="voidhormiga" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- "Open with Void Hormiga" on a .miga (a file manager, a chat, a mail).
           Android cannot match an extension on a content:// link, and a .miga
           arrives as a generic binary, so the filter is broad and the app checks
           the name: anything that is not a .miga is refused with a message.
           No storage permission: the link grants read access to that one file. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="content" android:mimeType="application/octet-stream" />
        <data android:scheme="content" android:mimeType="application/zip" />
        <data android:scheme="content" android:mimeType="application/x-miga" />
      </intent-filter>
    </activity>
  </application>
</manifest>
